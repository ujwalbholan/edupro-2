{
  "name": "my-turborepo",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "author": "",
  "license": "UNLICENSED",
  "scripts": {
    "predev": "docker compose -f infrastructure/docker/docker-compose.yml --env-file infrastructure/docker/.env up -d",
    "dev": "turbo run dev",
    "dev:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "pnpm --filter @repo/database-config generate",
    "db:migrate": "pnpm --filter @repo/database-config migrate",
    "db:studio": "pnpm --filter @repo/database-config studio"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "prettier": "^3.2.5",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@8.15.5",
  "engines": {
    "node": ">=18"
  }
}
